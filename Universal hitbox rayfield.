-- ============================================
-- CHARACTER PARENT
-- ============================================
local CHAR_PARENT = nil

local function GetCharParent()
    local charParent
    local waited = 0
    repeat
        task.wait(0.1)
        waited = waited + 0.1
    until LocalPlayer.Character or waited > 10
    if not LocalPlayer.Character then return nil end
    for _, char in pairs(workspace:GetDescendants()) do
        if string.find(char.Name, LocalPlayer.Name) and char:FindFirstChild("Humanoid") then
            charParent = char.Parent
            break
        end
    end
    return charParent
end

task.spawn(function()
    CHAR_PARENT = GetCharParent()
end)

-- ============================================
-- HITBOX
-- ============================================
local hitboxConnections = {}

local function resetHitbox(char)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Size = Vector3.new(2, 2, 1)
        hrp.Transparency = 1
        hrp.CanCollide = true
        hrp.Color = Color3.fromRGB(255, 255, 0)
    end
end

local function AssignHitbox(player)
    if player == LocalPlayer then return end
    if hitboxConnections[player] then return end

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not CHAR_PARENT then return end
        local char = CHAR_PARENT:FindFirstChild(player.Name)
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if Config.TeamCheck and player.Team == LocalPlayer.Team then
            resetHitbox(char)
            return
        end

        if getgenv().HBE then
            hrp.Size = Config.Size
            hrp.Color = Config.Color
            hrp.Transparency = Config.Transparency
            hrp.CanCollide = Config.CanCollide
        else
            if hrp.Size ~= Vector3.new(2, 2, 1) or hrp.Transparency ~= 1 then
                resetHitbox(char)
            end
        end
    end)
    hitboxConnections[player] = conn
end

for _, player in ipairs(Players:GetPlayers()) do
    AssignHitbox(player)
end
Players.PlayerAdded:Connect(AssignHitbox)

-- ============================================
-- ESP HELPERS
-- ============================================
local function getClosestPlayer()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end

    local closest, closestDist = nil, Config.ESPRange
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (myHrp.Position - hrp.Position).Magnitude
                if d < closestDist then
                    closest, closestDist = p, d
                end
            end
        end
    end
    return closest
end

-- ============================================
-- ESP
-- ============================================
local espData = {}

local function createESP(player)
    if player == LocalPlayer then return end
    if espData[player] then return end

    local box = Drawing.new("Square")
    box.Thickness = 2; box.Filled = false; box.Transparency = 1; box.Color = Config.ESPColor

    local nameTag = Drawing.new("Text")
    nameTag.Size = 16; nameTag.Center = true; nameTag.Outline = true
    nameTag.OutlineColor = Color3.fromRGB(0, 0, 0)
    nameTag.Color = Color3.fromRGB(255, 255, 255)
    nameTag.Transparency = 1

    local healthBg = Drawing.new("Square")
    healthBg.Thickness = 1; healthBg.Filled = true
    healthBg.Color = Color3.fromRGB(30, 30, 30); healthBg.Transparency = 1

    local healthBar = Drawing.new("Square")
    healthBar.Thickness = 1; healthBar.Filled = true
    healthBar.Color = Color3.fromRGB(0, 255, 0); healthBar.Transparency = 1

    local distTag = Drawing.new("Text")
    distTag.Size = 13; distTag.Center = true; distTag.Outline = true
    distTag.OutlineColor = Color3.fromRGB(0, 0, 0)
    distTag.Color = Color3.fromRGB(255, 255, 0); distTag.Transparency = 1

    espData[player] = { box=box, nameTag=nameTag, healthBg=healthBg, healthBar=healthBar, distTag=distTag }

    local conn
    conn = RunService.RenderStepped:Connect(function()
        local char = player.Character
        local hideAll = function()
            box.Visible, nameTag.Visible = false, false
            healthBg.Visible, healthBar.Visible = false, false
            distTag.Visible = false
        end

        if not char or not Config.ESP then hideAll() return end
        if Config.ESPClosestOnly and getClosestPlayer() ~= player then hideAll() return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not head or not hum then hideAll() return end

        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHrp and (myHrp.Position - hrp.Position).Magnitude > Config.ESPRange then hideAll() return end

        local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
        local feetPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

        if onScreen then
            local height = math.abs(headPos.Y - feetPos.Y)
            local width = height * 0.6
            local x = hrpPos.X - width / 2
            local y = headPos.Y

            box.Size = Vector2.new(width, height)
            box.Position = Vector2.new(x, y)
            box.Color = Config.ESPColor
            box.Visible = true

            nameTag.Text = player.Name
            nameTag.Position = Vector2.new(hrpPos.X, y - 20)
            nameTag.Visible = true

            healthBg.Size = Vector2.new(3, height)
            healthBg.Position = Vector2.new(x - 8, y)
            healthBg.Visible = true

            local hpRatio = hum.Health / hum.MaxHealth
            healthBar.Size = Vector2.new(3, height * hpRatio)
            healthBar.Position = Vector2.new(x - 8, y + (height * (1 - hpRatio)))
            healthBar.Color = Color3.fromRGB(255 * (1 - hpRatio), 255 * hpRatio, 0)
            healthBar.Visible = true

            local dist = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
            distTag.Text = dist .. " studs"
            distTag.Position = Vector2.new(hrpPos.X, y + height + 22)
            distTag.Visible = true
        else
            hideAll()
        end
    end)

    espData[player].conn = conn
end

local function removeESP(player)
    local d = espData[player]
    if not d then return end
    if d.conn then d.conn:Disconnect() end
    for _, obj in pairs(d) do
        if typeof(obj) == "userdata" then pcall(function() obj:Remove() end) end
    end
    espData[player] = nil
end

for _, player in ipairs(Players:GetPlayers()) do createESP(player) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

